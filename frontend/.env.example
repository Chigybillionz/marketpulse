# Environment Variables Configuration

# Copy this file to .env.local and fill in your values
# Make sure VITE_BACKEND_URL points to your running backend
# DO NOT commit .env.local to Git - it contains sensitive information

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
VITE_APP_NAME=MarketPulse AI

# Backend API URL - Set this to your backend URL
# For local development: http://localhost:5000/api
# For production: https://your-backend-on-render.com/api
VITE_BACKEND_URL=http://localhost:5000/api

# Feature Flags (optional)
VITE_ENABLE_VOICE=true
VITE_ENABLE_AI_CONFIRMATION=true
VITE_ENABLE_ANALYTICS=false

# Sentry Configuration (optional, for error tracking)
# VITE_SENTRY_DSN=your_sentry_dsn_here
