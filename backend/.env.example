PORT=5000
MONGO_URI=mongodb://localhost:27017/marketpulse
JWT_SECRET=replace-with-a-long-random-secret

# Real email delivery for Forgot PIN.
# Gmail users: use an App Password, not your normal Gmail password.
SMTP_SERVICE=gmail
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MarketPulse AI <your-sender@gmail.com>"

# For providers like SendGrid, Mailgun, Zoho, Brevo, or custom SMTP,
# use these instead of SMTP_SERVICE.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
